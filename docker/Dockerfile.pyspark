FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV SCALE_FACTOR=1.0
ENV SPARK_LOCAL_IP=127.0.0.1

RUN apt-get update -o Acquire::AllowInsecureRepositories=true 2>/dev/null; \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
       software-properties-common gnupg ca-certificates; \
    add-apt-repository ppa:deadsnakes/ppa -y 2>/dev/null || \
       echo "deb http://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" > /etc/apt/sources.list.d/deadsnakes.list; \
    apt-get update -o Acquire::AllowInsecureRepositories=true 2>/dev/null; \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
       python3.11 python3.11-dev python3.11-venv python3-pip \
       openjdk-17-jdk build-essential git curl wget \
       libssl-dev libffi-dev libsqlite3-dev \
       libbz2-dev liblzma-dev zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
 && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

WORKDIR /root

RUN cd /root && \
    rm -rf polars-benchmark && \
    git clone https://github.com/gabrielranulfo/polars-benchmark.git && \
    cd polars-benchmark && \
    git checkout mestrado-elasticidade

WORKDIR /root/polars-benchmark

# Install Python dependencies
RUN pip3 install --no-cache-dir --upgrade pip uv && \
    uv pip install --compile --system -r requirements.txt && \
    pip3 install --no-cache-dir psutil polars-lts-cpu

ENV PYTHONPATH=/root/polars-benchmark

# PySpark command
CMD ["python", "-m", "queries.pyspark"]
